rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isSignedIn()   { return request.auth != null; }
    function isOwner(uid)   { return request.auth.uid == uid; }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['admin', 'superadmin'];
    }
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    // ── Users ───────────────────────────────────────────────────
    match /users/{uid} {
      // Any signed-in user can read profiles (leaderboard / comments show names)
      allow read:   if isSignedIn();
      // Only the owner can create their own document (enforced by UID match)
      allow create: if isSignedIn() && isOwner(uid);
      // Owner updates their own stats; admins can change role field
      allow update: if isOwner(uid) || isAdmin();
      // Only super-admin can hard-delete a user record
      allow delete: if isSuperAdmin();
    }

    // ── Problems ────────────────────────────────────────────────
    match /problems/{problemId} {
      // Problems are publicly readable (unauthenticated users can browse)
      allow read:                   if true;
      allow create, update, delete: if isAdmin();

      // Comments subcollection
      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isSignedIn();
        // Owner or admin can update (likes/dislikes use arrayUnion so any
        // signed-in user needs update access on comments they didn't write)
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      }
    }

    // ── Submissions ─────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Require authentication to read submissions.
      // The leaderboard queries only run when the user is logged in anyway.
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
