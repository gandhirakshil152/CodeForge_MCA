rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isSignedIn()   { return request.auth != null; }
    function isOwner(uid)   { return request.auth.uid == uid; }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['admin', 'superadmin'];
    }
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    // ── Users ───────────────────────────────────────────────────
    match /users/{uid} {
      // Public read for leaderboard; signed-in for write
      allow read:   if true;
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Problems ────────────────────────────────────────────────
    match /problems/{problemId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();

      // Comments subcollection
      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      }
    }

    // ── Submissions (code judge) ─────────────────────────────────
    match /submissions/{submissionId} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── DBMS Questions ───────────────────────────────────────────
    match /dbms_questions/{questionId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }

    // ── DBMS Submissions ─────────────────────────────────────────
    match /dbms_submissions/{submissionId} {
      // Students can create their own submissions and read all
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      // Admins can delete/update
      allow update, delete: if isAdmin();
    }

    // ── Tests (MCQ & Coding) ──────────────────────────────────────
    match /mcq_tests/{testId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Test Questions ───────────────────────────────────────────
    match /mcq_questions/{questionId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Test Results & Proctoring ─────────────────────────────────
    match /test_results/{resultId} {
      allow read:                   if isSignedIn();
      allow create:                 if isSignedIn();
      allow update, delete:         if isAdmin();
    }

    // ── Daily Tasks ──────────────────────────────────────────────
    match /daily_tasks/{taskId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isSignedIn();
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
